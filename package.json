    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.1",
    "esm-env": "^1.2.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.17.0",
