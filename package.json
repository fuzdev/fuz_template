{
	"name": "@fuzdev/fuz_template",
	"version": "0.0.1",
	"description": "a web app template with TypeScript + SvelteKit + optional Rust for the fuz-stack",
	"glyph": "❄",
	"logo": "logo.svg",
	"logo_alt": "a friendly orange pixelated spider facing you",
	"license": "0BSD",
	"private": true,
