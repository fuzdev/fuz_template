    "@fuzdev/fuz_ui": "^0.221.0",
    "@fuzdev/fuz_util": "^0.79.0",
    "@fuzdev/gro": "^0.223.0",
    "@fuzdev/mdz": "^0.7.0",
    "@ryanatkn/eslint-config": "^0.13.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.9",
