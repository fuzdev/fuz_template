		"@fuzdev/gro": "^0.222.0",
		"@fuzdev/mdz": "^0.6.0",
		"@ryanatkn/eslint-config": "^0.13.1",
		"@sveltejs/acorn-typescript": "^1.0.13",
		"@sveltejs/adapter-static": "^4.0.0",
